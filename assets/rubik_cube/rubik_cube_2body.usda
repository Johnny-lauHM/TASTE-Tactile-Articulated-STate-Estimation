    def PhysicsRevoluteJoint "twist_joint" (
        prepend apiSchemas = ["PhysicsDriveAPI:angular", "PhysxJointAPI"]
    )
    {
        rel physics:body0 = </rubik_cube/core>
        rel physics:body1 = </rubik_cube/top>
        uniform token physics:axis = "Z"
        point3f physics:localPos0 = (0, 0, 0)
        point3f physics:localPos1 = (0, 0, 0)
        quatf physics:localRot0 = (1, 0, 0, 0)
        quatf physics:localRot1 = (1, 0, 0, 0)
        float drive:angular:physics:stiffness = 0
        float drive:angular:physics:damping = 1e-05
        float drive:angular:physics:maxForce = 1000
        uniform token drive:angular:physics:type = "force"
        float physxJoint:jointFriction = 0.0
        float physxJoint:armature = 0.0001
    }
}
